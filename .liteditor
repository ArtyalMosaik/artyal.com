{
  "content_path": "src/content",
  "assets_path": "public/images",
  "settings_file": "src/data/site.json",
  "schema": {
    "logo": {
      "label": "Logo",
      "type": "image",
      "description": "Affiché dans l'en-tête de toutes les pages et utilisé comme icône de l'onglet du navigateur (SVG ou PNG conseillé)."
    },
    "siteName": {
      "label": "Nom du site",
      "type": "short-text",
      "description": "Titre affiché dans l'en-tête de toutes les pages."
    },
    "siteDescription": {
      "label": "Description du site",
      "type": "long-text",
      "description": "Résumé affiché par Google et lors des partages sur les réseaux sociaux (Facebook, Instagram…). Utilisé pour les pages sans description propre."
    },
    "homeLinkPage": {
      "label": "Accueil : page du lien",
      "type": "page",
      "extra": [
        {
          "value": "/contact",
          "label": "Contact"
        }
      ],
      "description": "Page vers laquelle mène le lien au centre de l'accueil."
    },
    "homeLink": {
      "label": "Accueil : texte du lien",
      "type": "short-text",
      "description": "Lien vers la galerie au centre de l'accueil (la flèche « > » est ajoutée automatiquement)."
    },
    "homeName": {
      "label": "Accueil : nom",
      "type": "short-text",
      "description": "Nom affiché en bas de l'accueil. Laisser vide pour masquer."
    },
    "homeSubtitle": {
      "label": "Accueil : sous-titre",
      "type": "short-text",
      "description": "Ligne sous le nom en bas de l'accueil. Laisser vide pour masquer."
    },
    "homeBackground": {
      "label": "Image de fond de l'accueil",
      "type": "image",
      "description": "Photo plein écran de la page d'accueil. Les tailles pour mobile, tablette et grand écran sont générées automatiquement : une grande photo (≥ 2560 px de large) convient."
    },
    "email": {
      "label": "E-mail de contact",
      "type": "short-text",
      "description": "Affiché sur la page Contact (lien mailto). Laisser vide pour masquer."
    },
    "phone": {
      "label": "Téléphone",
      "type": "short-text",
      "description": "Affiché tel quel sur la page Contact, ex. +33 7 77 20 95 00. Laisser vide pour masquer."
    },
    "instagram": {
      "label": "Lien Instagram",
      "type": "link",
      "description": "Icône affichée sur l'accueil et la page Contact. Laisser vide pour masquer."
    },
    "facebook": {
      "label": "Lien Facebook",
      "type": "link",
      "description": "Icône affichée sur l'accueil et la page Contact. Laisser vide pour masquer."
    },
    "copyright": {
      "label": "Texte du pied de page",
      "type": "short-text",
      "description": "Affiché en bas de chaque page, suivi de « Site réalisé par Alexis Rossfelder »."
    }
  },
  "frontmatter": {
    "title": {
      "label": "Titre",
      "type": "short-text",
      "description": "Titre de la page (affiché en en-tête si « Afficher le titre » est coché, et utilisé dans l'onglet du navigateur)"
    },
    "menu": {
      "label": "Texte dans le menu",
      "type": "short-text",
      "description": "Nom du lien dans la barre du haut. Laisser vide pour ne pas afficher la page dans le menu."
    },
    "menu_order": {
      "label": "Position dans le menu",
      "type": "short-text",
      "description": "1 = en premier (après Accueil). Contact reste toujours en dernier."
    },
    "show_title": {
      "label": "Afficher le titre",
      "type": "boolean",
      "description": "Affiche le titre en en-tête de la page. À laisser décoché pour les pages de fiches (Galerie, Chantiers)."
    },
    "description": {
      "label": "Description",
      "type": "long-text",
      "description": "Résumé de la page pour les moteurs de recherche (facultatif)"
    }
  },
  "elements": {
    "project": {
      "label": "Fiche œuvre / chantier",
      "description": "Une fiche de la Galerie ou des Chantiers : titre, texte, photos et note. Les fiches alternent automatiquement image à gauche / image à droite, dans l'ordre de la page.",
      "fields": {
        "title": {
          "label": "Titre",
          "type": "short-text",
          "description": "Nom de l'œuvre ou du chantier"
        },
        "description": {
          "label": "Description",
          "type": "long-text",
          "description": "Texte de présentation"
        },
        "footnote": {
          "label": "Note",
          "type": "long-text",
          "description": "Une ligne par information, en italique sous le texte : année, dimensions, matériaux, prix ou « Vendue »…"
        },
        "images": {
          "label": "Images",
          "type": "list",
          "itemSchema": {
            "label": "Image",
            "type": "image"
          },
          "description": "Photos du diaporama, dans l'ordre d'affichage"
        }
      },
      "display": {
        "title": "title",
        "description": "description",
        "images": "images"
      }
    },
    "slider": {
      "label": "Diaporama",
      "description": "Diaporama d'images à insérer n'importe où dans le texte d'une page (ex. À propos)",
      "fields": {
        "images": {
          "label": "Images",
          "type": "list",
          "itemSchema": {
            "label": "Image",
            "type": "image"
          },
          "description": "Photos du diaporama, dans l'ordre d'affichage"
        }
      },
      "display": {
        "images": "images"
      }
    }
  }
}
