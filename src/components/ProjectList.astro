---
import '../styles/projects.css';
import type { ProjectView } from '../utils/project';

interface Props {
  projects: ProjectView[];
}

const { projects } = Astro.props;

// Largeur affichée du slider : toute la largeur moins les marges (mobile), 2/3 de celle-ci sinon
const sizes = '(max-width: 600px) calc(100vw - 64px), calc((100vw - 64px) * 0.667)';
---

<main>
  {
    projects.map((project, projectIndex) => (
      <section class={project.side}>
        <div class="content">
          <h2>{project.title}</h2>
          <div class="description" set:html={project.html} />
        </div>

        <div class="slider no-select">
          {project.images.map((image, index) => (
            <img
              src={image.src}
              srcset={image.srcset}
              sizes={sizes}
              loading={projectIndex < 2 && index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              alt={`Image ${index + 1}`}
              class="item"
              style={`transition-duration: 0ms; transform: translateX(${index * 100}% );`}
            />
          ))}
          <div class="controls">
            <div class="prev no-select">&lt;</div>
            <div class="next no-select">&gt;</div>
          </div>
        </div>
      </section>
    ))
  }
</main>

<script>
  import '../scripts/slider';
</script>
