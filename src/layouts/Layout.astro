---
import { ClientRouter } from 'astro:transitions';
import '../styles/styles.css';
import { assetUrl } from '../utils/assets';
import { settings } from '../utils/site';
import { getMenu } from '../utils/pages';

interface Props {
  title: string;
  description?: string;
  /** Entrée du menu à marquer `current` (`home`, `contact` ou le nom du fichier de la page) */
  current?: string;
  /** Lien « Accueil » : `#` sur la page d'accueil elle-même */
  home?: boolean;
}

const { title, description = settings.siteDescription, current = '', home = false } = Astro.props;

const nav = await getMenu(home);
const logo = assetUrl(settings.logo);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <ClientRouter />
    <slot name="head" />
    <link rel="shortcut icon" href={logo} type="image/x-icon" />
  </head>

  <body>
    <header>
      <div id="top">
        <h1>{settings.siteName}</h1>
        <img src={logo} alt={settings.siteName} height="5em" width="3.5em" />
      </div>

      <ul id="navigation">
        {nav.map((item) => (
          <li class={current === item.id ? 'current' : ''}>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </header>
    <slot />
  </body>
</html>
