---
import Layout from '../layouts/Layout.astro';
import '../styles/index.css';
import SocialLinks from '../components/SocialLinks.astro';
import { pageUrl } from '../utils/assets';
import { BACKGROUND_WIDTHS, backgroundCss, backgroundUrl } from '../utils/background';

const site = 'https://www.artyal.com';
const title = 'ARTYAL Mozaïk - Accueil';
const ogDescription = 'Découvrez les créations en mosaïque de Yaëlle Lohé, artiste mosaïste.';
const ogImage = `${site}${backgroundUrl(1280).replace(/^.*?(\/res\/)/, '$1')}`;

// Image d'accueil (préchargée, masquée) : tailles responsives générées au build
const widths = BACKGROUND_WIDTHS.filter((w) => [320, 480, 640, 800, 1024, 1280, 1600, 1920].includes(w));
const src = backgroundUrl(320);
const srcset = widths.map((w) => `${backgroundUrl(w)} ${w}w`).join(', ');
const sizes = [...widths.slice(0, -1).map((w) => `(max-width: ${w}px) ${w}px`), '1920px'].join(', ');
---

<Layout
  title={title}
  description="Portfolio de Yaëlle Lohé, artiste mosaïste. Découvrez ses créations en mosaïque."
  current={['home']}
  home
>
  <Fragment slot="head">
    <!-- Open Graph meta tags for social media sharing (Facebook, Instagram) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={site} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <style is:inline set:html={backgroundCss()} />
  </Fragment>

  <main>
    <section id="contentG">
      <h2 class="texte-projet">
        <a href={pageUrl('pages/gallery.html')}>Découvrez les projets &gt;</a>
      </h2>
    </section>
  </main>

  <footer>
    <h3>Yaëlle Lohé</h3>
    <p>Artiste Mosaïste</p>

    <SocialLinks size="32px" />
  </footer>

  <img src={src} srcset={srcset} sizes={sizes} style="display: none;" alt="" />
</Layout>
