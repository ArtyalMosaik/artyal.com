---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import '../../styles/contact.css';
import { settings, phoneHref } from '../../utils/site';
---

<Layout
  title={`${settings.siteName} - Contact`}
  current="contact"
>
  <main>
    {settings.homeName && <h3>{settings.homeName}</h3>}
    <SocialLinks />

    {settings.email && <p><a href={`mailto:${settings.email}`} target="_blank">{settings.email}</a></p>}
    {settings.phone && <p><a href={phoneHref(settings.phone)}>{settings.phone}</a></p>}
  </main>

  <SiteFooter plain />
</Layout>
