---
import Layout from '../../layouts/Layout.astro';
import '../../styles/contact.css';
import { pageUrl } from '../../utils/assets';
---

<Layout
  title="ARTYAL Mozaïk - Contact"
  description="Portfolio de Yaëlle Lohé, artiste mosaïste. Découvrez ses créations en mosaïque."
  current={['chantier', 'contact']}
>
  <main>
    <h3>Yaëlle Lohé</h3>
    <div id="social">
      <a href="https://www.instagram.com/artyal.mosaik/">
        <img src={pageUrl('res/icons/instagram.svg')} alt="Instagram Logo" />
      </a>
      <a href="https://www.facebook.com/profile.php?id=61556821594463">
        <img src={pageUrl('res/icons/facebook.svg')} alt="Facebook Logo" />
      </a>
    </div>

    <p><a href="mailto:mosaik@artyal.com" target="_blank">mosaik@artyal.com</a></p>
    <p><a href="tel:+33777209500">+33 7 77 20 95 00</a></p>
  </main>
</Layout>
